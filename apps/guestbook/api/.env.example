# Copied to .env.local by `pnpm new` (git-ignored). Read by src/local.ts only.
PORT=8789
TABLE_NAME=dr4w-guestbook-local-main
DYNAMO_ENDPOINT=http://localhost:8100
AWS_REGION=us-east-1
# Same value for every project locally; must match web/.dev.vars
ORIGIN_SECRET=dev-origin-secret
# Comma-separated local consumers of this project's events, e.g. http://localhost:8788/api/_events
DEV_EVENT_TARGETS=
